{
  "jsPlugins": ["@shadcn/lint"],
  "ignorePatterns": [
    "dist/**",
    "convex/_generated/**",
    "convex/betterAuth/_generated/**",
    "convex/betterAuth/schema.ts",
    "public/favicon.svg"
  ],
  "rules": {},
  "overrides": [
    {
      "files": ["src/components/{NoticeCard,SavePauseNotice,SnapshotNotice}.tsx"],
      "plugins": ["react"],
      "rules": {
        "react/only-export-components": "error"
      }
    }
  ]
}
