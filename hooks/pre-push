#!/bin/sh
# Match verify:local and CI against the working tree, including uncommitted edits.
# Enable it from .git/hooks, so that the hooks there keep running, with
#   printf '#!/bin/sh\nexec "$(git rev-parse --show-toplevel)/hooks/pre-push" "$@"\n' > .git/hooks/pre-push
#   chmod +x .git/hooks/pre-push
# Do not set core.hooksPath. Git would then skip .git/hooks, including the
# post-checkout hook that copies the maintainers' instructions into each
# checkout as AGENTS.md. Branch protection already makes
# main require the quality (CI) and secrets (Secret scanning) checks. This gate
# finds the same quality failures before a push instead of in CI. --no-verify is
# for scratch work.
set -e

cd "$(git rev-parse --show-toplevel)"
# Git exports GIT_DIR to the hook. In a linked worktree it names the worktree's
# Git directory, and a test's `git init` would then set core.bare in the real
# repository's config, so the gate finds the repository from its directory.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX

# Show errors locally; CI also emits advisory warnings as annotations.
run() {
  printf '  %-24s' "$1"
  shift
  if "$@" >/tmp/qivo-pre-push.$$ 2>&1; then
    printf 'ok\n'
  else
    printf 'FAILED\n\n'
    cat /tmp/qivo-pre-push.$$
    rm -f /tmp/qivo-pre-push.$$
    printf '\npush aborted. Fix the above, or `git push --no-verify` to override.\n'
    exit 1
  fi
  rm -f /tmp/qivo-pre-push.$$
}

printf 'quality gate\n'
run 'node version'      node scripts/node-version.mjs
run 'biome ci'          npx biome ci . --diagnostic-level=error
run 'lint'              npm run --silent lint
run 'UI conventions'    npm run --silent check:ui
run 'typecheck coverage' npm run --silent check:typecheck
run 'typecheck'         npm run --silent typecheck
run 'typecheck:strict'  npm run --silent typecheck:strict
run 'typecheck:convex'  npm run --silent typecheck:convex
run 'typecheck:desktop' npm run --silent typecheck:desktop
run 'typecheck:node'    npm run --silent typecheck:node
run 'build'             npm run --silent build
# Match verify:local's worker cap so fixture-heavy tests have CPU headroom.
run 'test'              npm test --silent -- --maxWorkers=2
printf 'all green\n'
