{
  "name": "qivo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npx convex dev\" \"vite --port 5199 --strictPort\"",
    "build": "tsc --noEmit && vite build && node scripts/verify-agent-guides.mjs && node scripts/docs-contract.mjs && node scripts/verify-panel-css.mjs",
    "lint": "oxlint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.mts",
    "verify:local": "npx biome ci . --diagnostic-level=error && npm run lint && npm run check:ui && npm run typecheck && npm run typecheck:strict && npm run typecheck:convex && npm run typecheck:desktop && npm run build && npm test -- --maxWorkers=2",
    "check:ui": "node scripts/check-ui-migration.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "typecheck:convex": "tsc --noEmit -p convex",
    "typecheck:desktop": "tsc --noEmit -p desktop",
    "demo": "node scripts/marketing-demo.mjs",
    "desktop:compile": "tsc -p desktop/tsconfig.json",
    "desktop:dev": "npm run desktop:compile && concurrently -k \"vite --port 5199 --strictPort\" \"wait-on http://localhost:5199/app.html && cross-env QIVO_DESKTOP_DEV=1 QIVO_DESKTOP_URL=http://localhost:5199/app electron desktop\"",
    "desktop:build": "npm run build && npm run desktop:compile",
    "desktop:package": "npm run desktop:build && electron-builder --config desktop/electron-builder.cjs --win --publish never",
    "desktop:package:linux": "npm run desktop:build && electron-builder --config desktop/electron-builder.cjs --linux deb rpm AppImage --publish never",
    "desktop:install": "npm --prefix desktop ci"
  },
  "dependencies": {
    "@better-auth/core": "1.6.31",
    "@better-auth/oauth-provider": "1.6.31",
    "@convex-dev/better-auth": "0.12.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-blockquote": "3.31.3",
    "@tiptap/extension-bold": "3.31.3",
    "@tiptap/extension-bubble-menu": "3.31.3",
    "@tiptap/extension-code": "3.31.3",
    "@tiptap/extension-code-block": "3.31.3",
    "@tiptap/extension-document": "3.31.3",
    "@tiptap/extension-hard-break": "3.31.3",
    "@tiptap/extension-heading": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-italic": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-mention": "3.31.3",
    "@tiptap/extension-paragraph": "3.31.3",
    "@tiptap/extension-strike": "3.31.3",
    "@tiptap/extension-text": "3.31.3",
    "@tiptap/extension-underline": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "better-auth": "1.6.31",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.45.0",
    "convex-helpers": "0.1.124",
    "fflate": "^0.8.3",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.45.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "0.35.5",
    "standardwebhooks": "^1.1.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@edge-runtime/vm": "5.0.0",
    "@shadcn/lint": "^0.1.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "10.0.5",
    "convex-test": "0.0.58",
    "cross-env": "^10.0.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "fast-check": "4.10.0",
    "markdown-it": "^15.0.2",
    "oxlint": "^1.85.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wait-on": "^9.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
