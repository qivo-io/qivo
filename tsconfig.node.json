{
  /* Typechecks the Node code outside src, convex and desktop, which is the
     hermetic and live tests in tests/, the Vitest configs and the declarations
     of scripts. The tests import convex/ the way Vite resolves it. allowJs
     reads the types of the .mjs files they import without checking them. */
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "allowJs": true
  },
  "include": ["tests", "vitest.config.mts", "vitest.contract.config.mts", "scripts/*.d.mts"]
}
